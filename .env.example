# Copy this file to .env and fill in your keys.
# Values typed into Importify's Settings page take priority over this file.
# After editing .env, reload the extension at chrome://extensions.

# OpenAI – used when Settings → Description → AI provider is "OpenAI"
OPENAI_API_KEY=
# Optional, defaults to gpt-5-mini
OPENAI_MODEL=

# Claude (Anthropic) – used when the AI provider is "Claude"
ANTHROPIC_API_KEY=
